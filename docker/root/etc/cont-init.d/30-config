#!/usr/bin/with-contenv bash

# Read the kernel's mount table without stat-ing the potentially stalled mount.
# By default include nested mounts; "covering" only checks the target itself
# and its ancestors so local files around a nested mount can still be owned.
has_network_mount() {
    [[ -r "${2:-/proc/self/mountinfo}" ]] || return 2
    # Pass target/scope through the environment, not awk -v: -v re-processes
    # escape sequences in the value, so a target containing a literal
    # backslash escape would decode differently from the mountinfo field it
    # is compared against and never match.
    TARGET="$1" SCOPE="${3:-any}" awk '
        BEGIN {
            target = ENVIRON["TARGET"]
            scope = ENVIRON["SCOPE"]
        }
        {
            mount = $5
            gsub(/\\040/, " ", mount)
            gsub(/\\011/, "\t", mount)
            gsub(/\\012/, "\n", mount)
            gsub(/\\134/, "\\", mount)
            for (i = 7; i <= NF; i++) {
                if ($i == "-") {
                    type = $(i + 1)
                    break
                }
            }
            if (type ~ /^(cifs|smb3|nfs|nfs4|9p|ceph|glusterfs|fuse.*)$/ &&
                (mount == "/" || mount == target ||
                 index(target, mount "/") == 1 ||
                 (scope == "any" && index(mount, target "/") == 1))) {
                found = 1
            }
        }
        END { exit !found }
    ' "${2:-/proc/self/mountinfo}"
}

# Print every decoded network mountpoint strictly under directory, from one
# awk pass over the mount table. The ownership pass skips and batches
# against this precomputed set instead of re-reading the table per entry.
network_mounts_under() {
    TARGET="$1" awk '
        BEGIN { target = ENVIRON["TARGET"] }
        {
            mount = $5
            gsub(/\\040/, " ", mount)
            gsub(/\\011/, "\t", mount)
            gsub(/\\012/, "\n", mount)
            gsub(/\\134/, "\\", mount)
            for (i = 7; i <= NF; i++) {
                if ($i == "-") {
                    type = $(i + 1)
                    break
                }
            }
            if (type ~ /^(cifs|smb3|nfs|nfs4|9p|ceph|glusterfs|fuse.*)$/ &&
                index(mount, target "/") == 1) {
                print mount
            }
        }
    ' "${2:-/proc/self/mountinfo}"
}

# Only invoked in a subprocess under the per-target timeout. Cost is one
# chown per directory entry on the nested-mount chain plus one batched
# chown per level covering every mount-free sibling subtree, so a large
# tree no longer spends one spawn per entry against the shared deadline:
# only directories that hold a nested network mount are recursed into, a
# mount-free subtree is chowned whole, and the mountpoint set comes from
# the precomputed NETWORK_MOUNTS array, not a per-entry table probe.
own_local_tree() {
    local directory="$1" owner="$2"
    local mount entry nested skip below=0 failed=0
    local batch=()
    for mount in "${NETWORK_MOUNTS[@]}"; do
        if [[ "$mount" == "$directory"/* ]]; then
            below=1
            break
        fi
    done
    if [[ "$below" -eq 0 ]]; then
        # Do not follow symlinks that might point into an excluded network mount.
        chown -h -R -- "$owner" "$directory"
        return $?
    fi
    chown -h -- "$owner" "$directory" || failed=1
    [[ -L "$directory" || ! -d "$directory" ]] && return "$failed"
    for entry in "$directory"/*; do
        skip=0
        nested=0
        for mount in "${NETWORK_MOUNTS[@]}"; do
            if [[ "$entry" == "$mount" ]]; then
                echo "[cont-init.d] Skipping ownership changes for network mount $entry; configure UID/GID on the host"
                skip=1
                break
            fi
            if [[ "$mount" == "$entry"/* ]]; then
                nested=1
            fi
        done
        [[ "$skip" -eq 1 ]] && continue
        if [[ "$nested" -eq 1 && -d "$entry" && ! -L "$entry" ]]; then
            own_local_tree "$entry" "$owner" || failed=1
        else
            batch+=("$entry")
        fi
    done
    if [[ "${#batch[@]}" -gt 0 ]]; then
        # One chown for the whole mount-free remainder of this level;
        # xargs chunks the operand list so it stays within exec limits.
        printf '%s\0' "${batch[@]}" | xargs -0 -r chown -h -R -- "$owner" || failed=1
    fi
    return "$failed"
}

configure_permissions() {
    local directory
    local mount_status
    local mountinfo="${1:-/proc/self/mountinfo}"
    local owner="${PUID:-1000}:${PGID:-1000}"
    local script="${BASH_SOURCE[0]}"
    local nested

    if [[ "$#" -gt 0 ]]; then shift; fi
    if [[ "$#" -eq 0 ]]; then set -- /data /downloads /transfers /blackhole /opt; fi

    if [[ "${PREMIUMIZEARR_SKIP_CHOWN:-false}" == "true" ]]; then
        echo "[cont-init.d] Skipping ownership changes (PREMIUMIZEARR_SKIP_CHOWN=true)"
        return 0
    fi

    for directory in "$@"; do
        nested=false
        if has_network_mount "$directory" "$mountinfo"; then
            mount_status=0
        else
            mount_status=$?
        fi
        if [[ "$mount_status" -eq 0 ]]; then
            if has_network_mount "$directory" "$mountinfo" covering; then
                echo "[cont-init.d] Skipping ownership changes for network mount $directory; configure UID/GID on the host"
                continue
            else
                mount_status=$?
            fi
            if [[ "$mount_status" -ne 1 ]]; then
                echo "[cont-init.d] Cannot read mount information; skipping ownership changes for $directory"
                continue
            fi
            nested=true
        elif [[ "$mount_status" -ne 1 ]]; then
            echo "[cont-init.d] Cannot read mount information; skipping ownership changes for $directory"
            continue
        fi

        echo "[cont-init.d] Setting ownership of $directory to $owner"
        # coreutils timeout is installed in the image. The kill deadline also
        # terminates the supervisor if chown is stuck in uninterruptible I/O.
        if [[ "$nested" == true ]]; then
            # Bound enumeration and all ownership work with one deadline, even
            # when there are many local siblings or deeply nested mounts.
            if ! timeout --kill-after=2s 10s bash "$script" --local-ownership "$directory" "$owner" "$mountinfo"; then
                echo "[cont-init.d] Ownership change failed or timed out for $directory; continuing startup (check host permissions)"
            fi
        elif ! timeout --kill-after=2s 10s chown -R -- "$owner" "$directory"; then
            echo "[cont-init.d] Ownership change failed or timed out for $directory; continuing startup (check host permissions)"
        fi
    done
    return 0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    if [[ "${1:-}" == --local-ownership ]]; then
        shopt -s dotglob nullglob
        # Byte-wise glob order keeps the batched chown operand order stable.
        export LC_ALL=C
        # One awk pass over the mount table precomputes the network
        # mountpoints below the target, so the ownership pass skips and
        # batches against a string set instead of probing per entry.
        if has_network_mount "$2" "${4:-/proc/self/mountinfo}" covering; then
            echo "[cont-init.d] Skipping ownership changes for network mount $2; configure UID/GID on the host"
        else
            mount_status=$?
            if [[ "$mount_status" -eq 1 ]]; then
                mapfile -t NETWORK_MOUNTS < <(network_mounts_under "$2" "${4:-/proc/self/mountinfo}")
                own_local_tree "$2" "$3"
            fi
        fi
    else
        configure_permissions
    fi
fi
