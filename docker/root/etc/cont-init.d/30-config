#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Decode the mount table's mountpoint field (field 5), classify the
# record's fstype, and apply the caller's filter in one awk pass,
# before anything is printed. The decode (the kernel escapes
# space/tab/newline/backslash as \040/\011/\012/\134 in the root and
# mountpoint fields), the network-fstype test, and the covering/any/
# under filter all run inside the same record, so a mountpoint that
# contains a newline stays one record end to end, a record without a
# " - " fstype separator cannot inherit the previous record's fstype,
# and has_network_mount and network_mounts_under classify "network"
# identically by construction. fuse-overlayfs is excluded in both of its
# spellings - the helper name and the kernel-reported
# "fuse.fuse-overlayfs", where the fuse module prefixes the helper's
# name: under rootless container runtimes it is the local root
# filesystem, not a network mount. Matches are NUL-terminated: the
# container's awk is busybox, where printf "%s\0" truncates at the NUL,
# while
# printf "%s%c", m, 0 writes a real NUL on busybox, gawk and mawk
# alike; consumers read the stream back with mapfile -d ''.
network_mount_lines() {
    local mountinfo="${1:-/proc/self/mountinfo}"
    local target="$2" scope="${3:-any}"
    # Pass target/scope through the environment, not awk -v: -v
    # re-processes escape sequences in the value, so a target
    # containing a literal backslash escape would decode differently
    # from the mountinfo field it is compared against and never match.
    TARGET="$target" SCOPE="$scope" awk '
        BEGIN {
            target = ENVIRON["TARGET"]
            scope = ENVIRON["SCOPE"]
        }
        {
            mount = $5
            gsub(/\\040/, " ", mount)
            gsub(/\\011/, "\t", mount)
            gsub(/\\012/, "\n", mount)
            gsub(/\\134/, "\\", mount)
            type = ""
            for (i = 6; i <= NF; i++) {
                if ($i == "-") {
                    type = $(i + 1)
                    break
                }
            }
            is_network = (type ~ /^(cifs|smb3|nfs|nfs4|9p|ceph|glusterfs)$/ ||
                (type ~ /^fuse/ && type != "fuse-overlayfs" &&
                    type != "fuse.fuse-overlayfs"))
            if (!is_network)
                next
            if (scope == "under") {
                if (index(mount, target "/") == 1)
                    printf "%s%c", mount, 0
            } else if (scope == "covering") {
                if (mount == "/" || mount == target || index(target, mount "/") == 1)
                    printf "%s%c", mount, 0
            } else if (mount == "/" || mount == target ||
                index(target, mount "/") == 1 ||
                index(mount, target "/") == 1) {
                printf "%s%c", mount, 0
            }
        }
    ' "$mountinfo"
}

# Read the kernel's mount table without stat-ing the potentially stalled mount.
# By default include nested mounts; "covering" only checks the target itself
# and its ancestors so local files around a nested mount can still be owned.
# Status 2 means the table cannot be read (missing, or a directory, which a
# bare -r test would accept): the caller must skip ownership instead of
# treating the target as local.
has_network_mount() {
    local mountinfo="${2:-/proc/self/mountinfo}"
    [[ -f "$mountinfo" && -r "$mountinfo" ]] || return 2
    local matches=()
    mapfile -d '' -t matches < <(network_mount_lines "$mountinfo" "$1" "${3:-any}")
    [[ "${#matches[@]}" -gt 0 ]]
}

# Resolve a path with filesystem semantics in one left-to-right walk: a
# component is appended to the resolved prefix and, the moment the prefix
# is a symlink, its target is read (an lstat-only probe,
# AT_SYMLINK_NOFOLLOW semantics) and the walk restarts on the target's
# components - including any ".." or further links inside them - before
# the original suffix is processed. That is the kernel's order: "…/a/.."
# with a -> b/c lands on b, so a ".." that follows a link resolves
# against the link's destination, never against the link's spelling.
# Every $(...) crossing is sentinel-marked, because command substitution
# strips trailing newlines: readlink keeps a target that ends in a
# newline (the appended "x" survives the strip), and this function emits
# the resolved spelling as <spelling>x<status>, where status is
# c = the walk finished with no link left, y = a spelling repeated (a
# link cycle), p = the 40-link walk budget is exhausted with a live link
# still blocking, or s = a stale link. canonical_target strips the
# sentinels and repeats the walk until the spelling stops moving.
resolve_symlink_prefix() {
    local path="$1" prefix link parent absolute=0
    [[ "$path" == /* ]] && absolute=1
    local -a parts=()
    # Split on NUL, not newline: a decoded readlink target may carry a
    # newline (the kernel escapes it in the mount table), which a
    # here-string would truncate at and append its own newline into the
    # last component of. read -d '' returns 1 at end-of-input without a
    # NUL; the guard swallows that under set -e.
    IFS='/' read -r -d '' -a parts < <(printf '%s' "$path") || true
    prefix=""
    local -A seen=()
    local spelling="" comp
    for comp in "${parts[@]}"; do
        if [[ -z "$spelling" ]]; then
            spelling="$comp"
        else
            spelling+="/$comp"
        fi
    done
    [[ -n "$spelling" ]] && seen["$spelling"]=1
    local status=c left=40 resolved=0
    local -a newparts=()
    local i=0 n=${#parts[@]} j pre post
    while (( i < n )); do
        comp="${parts[i]}"
        if [[ -z "$comp" || "$comp" == "." ]]; then
            i=$((i + 1))
            continue
        fi
        if [[ "$comp" == ".." ]]; then
            # The prefix here is fully resolved (a link is resolved the
            # moment it is appended), so a string pop is exactly what the
            # kernel does; the root itself stays sticky.
            if [[ "$prefix" == "/" ]]; then
                :
            elif [[ "$prefix" == */* ]]; then
                prefix="${prefix%/*}"
                [[ -z "$prefix" ]] && prefix="/"
            elif [[ -n "$prefix" ]]; then
                prefix=""
            fi
            i=$((i + 1))
            continue
        fi
        if [[ -z "$prefix" || "$prefix" == "." || "$prefix" == "/" ]]; then
            if [[ "$absolute" -eq 1 ]]; then prefix="/$comp"; else prefix="$comp"; fi
        else
            prefix+="/$comp"
        fi
        if [[ -L "$prefix" ]]; then
            # Sentinel: command substitution strips the trailing newlines
            # of the link target, so the appended "x" survives them;
            # readlink itself terminates its output with a newline, so
            # strip exactly that one plus the sentinel, keeping any
            # newlines that are part of the target itself.
            link="$(readlink "$prefix" 2>/dev/null; printf x)"
            if [[ "$link" == "x" ]]; then
                link=""
            else
                link="${link%$'\n'x}"
            fi
            if [[ -z "$link" ]]; then
                # Stale link: keep the spelling, let chown report it.
                status=s
                break
            fi
            # The spelling before and after this resolution, built with
            # the walk's own append rules (dots skipped, root anchored
            # like the walk, an absolute target rooted on /) so a repeat
            # is recognised whichever root the walk is anchored on. The
            # repeat check must run before the budget check so a cycle
            # whose closing link sits exactly at the budget boundary is
            # reported as a cycle, like a shorter one.
            pre="$prefix"
            for ((j = i + 1; j < n; j++)); do
                comp="${parts[j]}"
                if [[ -z "$comp" || "$comp" == "." ]]; then
                    continue
                fi
                if [[ -z "$pre" || "$pre" == "." || "$pre" == "/" ]]; then
                    if [[ "$pre" == "/" ]]; then pre="/$comp"; else pre="$comp"; fi
                else
                    pre+="/$comp"
                fi
            done
            if [[ "$link" == /* ]]; then
                absolute=1
                parent=""
            else
                parent="${prefix%/*}"
                # A relative target joins to the prefix's parent
                # directory, rooted where the input itself is rooted: an
                # absolute prefix joins against /, a relative prefix
                # against the caller's cwd, so a relative input never
                # re-roots onto /.
                if [[ -z "$parent" || "$parent" == "$prefix" ]]; then
                    if [[ "$absolute" -eq 1 ]]; then parent="/"; else parent="."; fi
                fi
            fi
            IFS='/' read -r -d '' -a newparts < <(printf '%s' "$link") || true
            for ((j = i + 1; j < n; j++)); do
                newparts+=("${parts[j]}")
            done
            post="$parent"
            # An absolute link target re-roots the walk on /.
            [[ -z "$post" ]] && post="/"
            for ((j = 0; j < ${#newparts[@]}; j++)); do
                comp="${newparts[j]}"
                if [[ -z "$comp" || "$comp" == "." ]]; then
                    continue
                fi
                if [[ -z "$post" || "$post" == "." || "$post" == "/" ]]; then
                    if [[ "$post" == "/" ]]; then post="/$comp"; else post="$comp"; fi
                else
                    post+="/$comp"
                fi
            done
            if [[ "$post" == "$pre" ]]; then
                # The link leads back to its own spelling: a one-link
                # fixed point, which converges silently.
                status=c
                break
            fi
            if [[ -n "${seen[$post]:-}" ]]; then
                # An earlier spelling reappears: a link cycle.
                status=y
                break
            fi
            seen["$post"]=1
            if (( left == 0 )); then
                # The walk budget is exhausted with a live link left:
                # the caller treats this as a chain that did not
                # converge, not as a cycle.
                status=p
                break
            fi
            left=$((left - 1))
            resolved=$((resolved + 1))
            prefix="$parent"
            n=${#newparts[@]}
            parts=("${newparts[@]}")
            i=0
            continue
        fi
        i=$((i + 1))
    done
    # Dot-process the components the walk stopped short of (a stale or
    # budget-blocked walk leaves the suffix unprocessed); link resolution
    # already happened left-to-right, so only dot cleanup remains.
    for ((j = i + 1; j < n; j++)); do
        comp="${parts[j]}"
        if [[ -z "$comp" || "$comp" == "." ]]; then
            continue
        fi
        if [[ "$comp" == ".." ]]; then
            if [[ "$prefix" == "/" ]]; then
                :
            elif [[ "$prefix" == */* ]]; then
                prefix="${prefix%/*}"
                [[ -z "$prefix" ]] && prefix="/"
            elif [[ -n "$prefix" ]]; then
                prefix=""
            fi
            continue
        fi
        if [[ -z "$prefix" || "$prefix" == "." ]]; then
            if [[ "$absolute" -eq 1 ]]; then prefix="/$comp"; else prefix="$comp"; fi
        else
            prefix+="/$comp"
        fi
    done
    if [[ -z "$prefix" ]]; then
        if [[ "$absolute" -eq 1 ]]; then prefix="/"; else prefix="."; fi
    fi
    # A walk that spent its whole budget on resolutions ends one link
    # short of canonical: report it as not converged, matching the
    # pass-based bound it replaced.
    if [[ "$status" == "c" && "$left" -eq 0 && "$resolved" -gt 0 ]]; then
        status=p
    fi
    printf '%sx%s' "$prefix" "$status"
}

# String-only path spelling normalisation: drop trailing slashes (keep the
# root itself), collapse "x/.." — including the bare "a/.." and "/a/.."
# forms whose pop target has no slash of its own — and drop "." so a
# relative readlink target lands in canonical form without touching the
# filesystem.
collapse_path_dots() {
    local path="$1" comp out="" absolute=0
    [[ "$path" == /* ]] && absolute=1
    local -a parts=()
    # Same NUL split as resolve_symlink_prefix: a decoded readlink target
    # may carry a newline a here-string would truncate at.
    IFS='/' read -r -d '' -a parts < <(printf '%s' "$path") || true
    for comp in "${parts[@]}"; do
        case "$comp" in
            '' | .) ;;
            ..) if [[ "$out" == */* ]]; then
                    out="${out%/*}"
                elif [[ -n "$out" ]]; then
                    out=""
                fi
                ;;
            *) if [[ -z "$out" ]]; then
                    if [[ "$absolute" -eq 1 ]]; then out="/$comp"; else out="$comp"; fi
                else
                    out+="/$comp"
                fi
                ;;
        esac
    done
    if [[ -z "$out" ]]; then
        if [[ "$absolute" -eq 1 ]]; then out="/"; else out="."; fi
    fi
    printf '%s' "$out"
}

# Normalise a target's spelling before mount-table matching: strip trailing
# slashes and resolve the path with filesystem semantics
# (resolve_symlink_prefix), so "alias -> real" or "real/" matches the same
# mount-table entries as "real" and takes the same branch.
# The walk emits <spelling>x<status>: command substitution strips trailing
# newlines, so the sentinel keeps a destination that ends in a newline
# intact through every $(...) boundary; this function strips both markers
# and repeats the walk until the spelling stops moving. The status byte
# carries the walk's own verdict: y = a link cycle inside the walk,
# p = the 40-link walk budget exhausted with a live link left, c =
# converged, s = a stale link (the spelling is kept either way).
#
# The 40-pass bound stops the loop; it does not by itself detect cycles.
# A spelling that repeats (inside a walk, or across passes) is a genuine
# link cycle and keeps the original spelling with the "cycle detected"
# diagnostic; a chain that is still moving at the bound without any
# repeated spelling gets the distinct "did not converge" diagnostic and
# the same keep-the-original fallback.
canonical_target() {
    local target="$1" pass raw status canon prev original
    while [[ "$target" == */ && "$target" != "/" ]]; do
        target="${target%/}"
    done
    original="$target"
    prev=""
    local -A seen=()
    seen["$original"]=1
    local converged=0
    # Bounded iteration idiom: the counter only caps the passes.
    # shellcheck disable=SC2034
    for pass in {1..40}; do
        raw="$(resolve_symlink_prefix "$target")"
        status="${raw: -1}"
        raw="${raw%?}"
        canon="${raw%x}"
        if [[ "$status" == "y" ]]; then
            # A spelling repeated inside the walk: a link cycle.
            break
        fi
        if [[ "$canon" == "$target" ]]; then
            converged=1
            break
        fi
        if [[ "$status" == "p" ]]; then
            # The walk's link budget is exhausted with a live link left:
            # a chain that did not converge, not a cycle.
            break
        fi
        if [[ -n "$prev" && "$canon" == "$prev" ]]; then
            # Two spellings keep alternating: a two-link cycle.
            break
        fi
        if [[ -n "${seen[$canon]:-}" ]]; then
            # A longer cycle: an earlier spelling reappears.
            break
        fi
        seen["$target"]=1
        prev="$target"
        target="$canon"
    done
    if [[ "$converged" -eq 0 ]]; then
        if [[ "$status" == "y" ]] || [[ -n "$prev" && "$canon" == "$prev" ]] || [[ -n "${seen[$canon]:-}" ]]; then
            echo "[cont-init.d] Symlink cycle detected for $original; using the original spelling" >&2
        else
            echo "[cont-init.d] Symlink resolution did not converge for $original within 40 passes; using the original spelling" >&2
        fi
        target="$original"
    fi
    printf '%sx' "$target"
}

# Print every decoded network mountpoint strictly under directory, from one
# pass over the mount table. The ownership pass skips and batches
# against this precomputed set instead of re-reading the table per entry.
# Decode, classify, and filter all run in the shared classifier
# (network_mount_lines, mode "under"), so a mountpoint containing a
# newline stays one NUL-terminated element for the caller's mapfile.
network_mounts_under() {
    network_mount_lines "${2:-/proc/self/mountinfo}" "$1" under
}

# Only invoked in a subprocess under the per-target timeout. Cost is one
# chown per directory entry on the nested-mount chain plus one batched
# chown per level covering every mount-free sibling subtree, so a large
# tree no longer spends one spawn per entry against the shared deadline:
# only directories that hold a nested network mount are recursed into, a
# mount-free subtree is chowned whole, and the mountpoint set comes from
# the precomputed NETWORK_MOUNTS array, not a per-entry table probe.
own_local_tree() {
    local directory="$1" owner="$2"
    local mount entry nested skip below=0 failed=0
    local batch=()
    for mount in "${NETWORK_MOUNTS[@]}"; do
        if [[ "$mount" == "$directory"/* ]]; then
            below=1
            break
        fi
    done
    if [[ "$below" -eq 0 ]]; then
        # Do not follow symlinks that might point into an excluded network mount.
        chown -h -R -- "$owner" "$directory"
        return $?
    fi
    chown -h -- "$owner" "$directory" || failed=1
    [[ -L "$directory" || ! -d "$directory" ]] && return "$failed"
    for entry in "$directory"/*; do
        skip=0
        nested=0
        for mount in "${NETWORK_MOUNTS[@]}"; do
            if [[ "$mount" == "$entry" ]]; then
                echo "[cont-init.d] Skipping ownership changes for network mount $entry; configure UID/GID on the host"
                skip=1
                break
            fi
            if [[ "$mount" == "$entry"/* ]]; then
                nested=1
            fi
        done
        [[ "$skip" -eq 1 ]] && continue
        if [[ "$nested" -eq 1 && -d "$entry" && ! -L "$entry" ]]; then
            own_local_tree "$entry" "$owner" || failed=1
        else
            batch+=("$entry")
        fi
    done
    if [[ "${#batch[@]}" -gt 0 ]]; then
        # One chown for the whole mount-free remainder of this level;
        # xargs chunks the operand list so it stays within exec limits.
        printf '%s\0' "${batch[@]}" | xargs -0 -r chown -h -R -- "$owner" || failed=1
    fi
    return "$failed"
}

configure_target_ownership() {
    local directory="$1" owner="$2"
    local mountinfo="${3:-/proc/self/mountinfo}"
    local mount_status
    local nested=false
    local NETWORK_MOUNTS=()

    # Check the literal spelling first, without touching the target. A known
    # network mount needs no symlink probes, which can themselves stall. The
    # fast path is only sound for spellings without ".." components: with
    # them the resolved destination can sit outside the mount the raw
    # spelling appears to be under, so those targets fall through to
    # canonical resolution before any skip decision.
    local -a raw_parts=()
    IFS='/' read -r -d '' -a raw_parts < <(printf '%s' "$directory") || true
    local comp raw_has_dotdot=0
    for comp in "${raw_parts[@]}"; do
        if [[ "$comp" == ".." ]]; then
            raw_has_dotdot=1
            break
        fi
    done
    if [[ "$raw_has_dotdot" -eq 0 ]] && has_network_mount "$directory" "$mountinfo" covering; then
        echo "[cont-init.d] Skipping ownership changes for network mount $directory; configure UID/GID on the host"
        return 0
    else
        mount_status=$?
    fi
    if [[ "$mount_status" -ne 1 ]]; then
        echo "[cont-init.d] Cannot read mount information from $mountinfo; skipping ownership changes for $directory"
        return 0
    fi

    # Aliases and trailing slashes must still use the canonical spelling for
    # detection and traversal. All metadata lookups here share the deadline
    # with enumeration and chown, including targets not found in mountinfo.
    # canonical_target emits <spelling>x: command substitution strips
    # trailing newlines, so the sentinel keeps a destination that ends in
    # a newline intact through the assignment; strip exactly that one.
    directory="$(canonical_target "$directory")"
    directory="${directory%x}"
    if has_network_mount "$directory" "$mountinfo"; then
        mount_status=0
    else
        mount_status=$?
    fi
    if [[ "$mount_status" -eq 0 ]]; then
        if has_network_mount "$directory" "$mountinfo" covering; then
            echo "[cont-init.d] Skipping ownership changes for network mount $directory; configure UID/GID on the host"
            return 0
        else
            mount_status=$?
        fi
        if [[ "$mount_status" -ne 1 ]]; then
            echo "[cont-init.d] Cannot read mount information from $mountinfo; skipping ownership changes for $directory"
            return 0
        fi
        nested=true
    elif [[ "$mount_status" -ne 1 ]]; then
        echo "[cont-init.d] Cannot read mount information from $mountinfo; skipping ownership changes for $directory"
        return 0
    fi

    echo "[cont-init.d] Setting ownership of $directory to $owner"
    if [[ "$nested" == true ]]; then
        # The walk's shopts, LC_ALL export, and mount set must not leak
        # into a sourcing caller, so the branch runs in a subshell; the
        # walk's output and exit status pass through unchanged.
        (
            shopt -s dotglob nullglob
            # Byte-wise glob order keeps the batched chown operand order stable.
            export LC_ALL=C
            mapfile -d '' -t NETWORK_MOUNTS < <(network_mounts_under "$directory" "$mountinfo")
            own_local_tree "$directory" "$owner"
        )
    else
        chown -R -- "$owner" "$directory"
    fi
}

configure_permissions() {
    local directory
    local mountinfo="${1:-/proc/self/mountinfo}"
    local owner="${PUID:-1000}:${PGID:-1000}"
    local script="${BASH_SOURCE[0]}"

    if [[ "$#" -gt 0 ]]; then shift; fi
    if [[ "$#" -eq 0 ]]; then set -- /data /downloads /transfers /blackhole /opt; fi

    if [[ "${PREMIUMIZEARR_SKIP_CHOWN:-false}" == "true" ]]; then
        echo "[cont-init.d] Skipping ownership changes (PREMIUMIZEARR_SKIP_CHOWN=true)"
        return 0
    fi

    for directory in "$@"; do
        # coreutils timeout is installed in the image. The TERM deadline
        # bounds interruptible stalls in the supervised pass (mount
        # checks, path resolution, enumeration, chown); a child already
        # stuck in uninterruptible I/O cannot be signalled away, so the
        # kill-after value only bounds how long the supervisor waits for
        # the forced stop, and the runtime's startup timeout is the
        # backstop behind both. Start supervision before any filesystem
        # probes, and share one deadline for the target.
        if ! timeout --kill-after=2s 10s bash "$script" --ownership "$directory" "$owner" "$mountinfo"; then
            echo "[cont-init.d] Ownership change failed or timed out for $directory (mount table: $mountinfo); continuing startup (check host permissions)"
        fi
    done
    return 0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    if [[ "${1:-}" == --ownership ]]; then
        configure_target_ownership "$2" "$3" "${4:-/proc/self/mountinfo}"
    else
        # Forward caller arguments (mountinfo, then targets) instead of
        # silently dropping them in favour of the built-in defaults.
        configure_permissions "$@"
    fi
fi
