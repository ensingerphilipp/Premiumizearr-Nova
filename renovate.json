{
  "extends": ["config:recommended", "security:gomodIndirectSecurityUpdates"],
  "labels": ["dependencies"],
  "prBodyColumns": ["package", "from", "to", "changelog"],
  "minimumReleaseAge": "14 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "labels": ["breaking change"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Automerge patch updates once they pass CI and meet the minimum release age",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10
}
