#!/usr/bin/env bash
set -eu

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Deliberate tripwire: any direct chown in this process must fail. The
# fixture phases reach the PATH stub binary instead, because the ownership
# work runs in a subprocess; xargs can only ever invoke that binary, never
# this function.
# shellcheck disable=SC2032
chown() { echo "Unbounded chown must not run" >&2; exit 1; }
# The sourced entrypoint is linted on its own; run shellcheck with -x to
# follow this source (with -x, nothing below this line reports).
# shellcheck disable=SC1091
source "$root/docker/root/etc/cont-init.d/30-config"

mount_entry() {
    printf '20 10 0:1 / %s rw shared:1 - %s server rw\n' "$1" "$2"
}
fail() { echo "$*" >&2; exit 1; }

for type in cifs smb3 nfs nfs4 9p ceph glusterfs fuse.sshfs fuse.rclone; do
    for mount in /downloads /downloads/nested /; do
        mount_entry "$mount" "$type" > "$tmp/mountinfo"
        has_network_mount /downloads "$tmp/mountinfo" || fail "missed $type at $mount"
    done
done
mount_entry /media cifs > "$tmp/mountinfo"
has_network_mount /media/downloads "$tmp/mountinfo" || fail "missed ancestor mount"
mount_entry '/downloads/with\040spaces' cifs > "$tmp/mountinfo"
has_network_mount '/downloads/with spaces/subdir' "$tmp/mountinfo" || fail "escaped mountpoint not decoded"
mount_entry /downloads-other cifs > "$tmp/mountinfo"
if has_network_mount /downloads "$tmp/mountinfo"; then fail "path prefix matched a sibling"; fi
mount_entry /downloads ext4 > "$tmp/mountinfo"
if has_network_mount /downloads "$tmp/mountinfo"; then fail "local storage treated as network"; fi

# Stub the supervisor: assert every ownership command is bounded and that
# failures do not abort initialization or prevent later directories being tried.
# Invoked from the sourced 30-config as the command name `timeout`; shellcheck
# sees the call only with -x.
# shellcheck disable=SC2329
timeout() { printf '%s\n' "$*" >> "$tmp/calls"; return "${timeout_result:-0}"; }
# Dispatch every target using its original spelling. Resolution and mount
# classification belong to the supervised worker, including symlinked defaults.
DEFAULT_TARGETS=(/data /downloads /transfers /blackhole /opt)
unset PREMIUMIZEARR_SKIP_CHOWN PUID PGID
mount_entry /downloads cifs > "$tmp/mountinfo"
mount_entry /blackhole nfs4 >> "$tmp/mountinfo"
: > "$tmp/calls"
configure_permissions "$tmp/mountinfo" > "$tmp/output"
: > "$tmp/expected"
for t in "${DEFAULT_TARGETS[@]}"; do
    printf '%s\n' "--kill-after=2s 10s bash $root/docker/root/etc/cont-init.d/30-config --ownership $t 1000:1000 $tmp/mountinfo" >> "$tmp/expected"
done
diff -u "$tmp/expected" "$tmp/calls"

PUID=123
PGID=456
timeout_result=124
: > "$tmp/calls"
configure_permissions "$tmp/mountinfo" > "$tmp/output"
[[ "$(wc -l < "$tmp/calls")" -eq "${#DEFAULT_TARGETS[@]}" ]] || fail "a timeout prevented later targets"
grep -q -- '--ownership /data 123:456' "$tmp/calls" || fail "UID/GID not respected"
grep -q 'failed or timed out' "$tmp/output" || fail "timeout was not logged"

# Read by the sourced 30-config, not by this script; shellcheck only sees
# the cross-file use with -x.
# shellcheck disable=SC2034
PREMIUMIZEARR_SKIP_CHOWN=true
: > "$tmp/calls"
configure_permissions "$tmp/mountinfo" > "$tmp/output"
[[ ! -s "$tmp/calls" ]] || fail "explicit opt-out still changed ownership"

unset PREMIUMIZEARR_SKIP_CHOWN

# The canonical resolver: a symlink prefix keeps the components that follow
# it, a parent symlink resolves against the link's location, a plain path
# keeps its spelling, and a symlink cycle keeps the original spelling with a
# distinct diagnostic instead of a cap-terminated in-cycle spelling.
mkdir -p "$tmp/resolve/real" "$tmp/resolve/plain" "$tmp/resolve/pt/a" "$tmp/resolve/one" "$tmp/resolve/two"
touch "$tmp/resolve/b" "$tmp/resolve/pt/b"
ln -s real "$tmp/resolve/alias"
ln -s a "$tmp/resolve/pt/lnk"
ln -s one "$tmp/resolve/one/one"
ln -s y "$tmp/resolve/two/x"
ln -s x "$tmp/resolve/two/y"
[[ "$(canonical_target "$tmp/resolve/alias/b/c")" == "$tmp/resolve/real/b/c" ]] \
    || fail "symlink prefix resolution dropped the path suffix"
[[ "$(canonical_target "$tmp/resolve/pt/lnk/../b")" == "$tmp/resolve/pt/b" ]] \
    || fail "parent symlink did not resolve to the parent of the link location"
[[ "$(canonical_target "$tmp/resolve/pt/a/../b")" == "$tmp/resolve/pt/b" ]] \
    || fail "plain 'a/../b' spelling did not collapse"
[[ "$(canonical_target "$tmp/resolve/plain/")" == "$tmp/resolve/plain" ]] \
    || fail "trailing slash was not stripped"
canonical_target "$tmp/resolve/one/one" > "$tmp/oneout" 2> "$tmp/oneerr"
[[ "$(cat "$tmp/oneout")" == "$tmp/resolve/one/one" ]] \
    || fail "1-cycle target must stay a fixed point and keep its spelling"
if grep -q 'cycle' "$tmp/oneerr"; then
    fail "1-cycle raised the cycle diagnostic"
fi
canonical_target "$tmp/resolve/two/x/z" > "$tmp/twout" 2> "$tmp/twoerr"
[[ "$(cat "$tmp/twout")" == "$tmp/resolve/two/x/z" ]] \
    || fail "2-cycle must keep the original spelling, got: $(cat "$tmp/twout")"
grep -q 'Symlink cycle detected' "$tmp/twoerr" || fail "2-cycle did not raise the cycle diagnostic"

# Exercise the real bounded worker against a scratch tree. Stub only chown so
# the test can run without root and never change ownership outside the fixture.
mkdir -p "$tmp/bin" "$tmp/local/branch/nested" "$tmp/local/network"
touch "$tmp/local/config.yaml" "$tmp/local/branch/local.txt" "$tmp/local/.hidden" "$tmp/local/with spaces"
ln -s "$tmp/local/network" "$tmp/local/link"
cat > "$tmp/bin/chown" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$OWNERSHIP_CALLS"
exit "${CHOWN_RESULT:-0}"
STUB
chmod +x "$tmp/bin/chown"
export PATH="$tmp/bin:$PATH"
export OWNERSHIP_CALLS="$tmp/ownership-calls"
# Read by the sourced 30-config, not by this script; shellcheck only sees
# the cross-file use with -x.
# shellcheck disable=SC2034
PUID=1000
# shellcheck disable=SC2034
PGID=1000
timeout() { printf '%s\n' "$*" >> "$tmp/deadlines"; command timeout "$@"; }

# Missing mount information must skip ownership without probing the target.
: > "$OWNERSHIP_CALLS"
configure_permissions "$tmp/missing-mountinfo" "$tmp/local" > "$tmp/output" 2>&1
[[ ! -s "$OWNERSHIP_CALLS" ]] || fail "unknown mounts must not be traversed"
grep -q 'Cannot read mount information' "$tmp/output" || fail "mount table error was not logged"

# The flat chown must target the original spelling, never an in-cycle one:
# the supervised resolver keeps its diagnostic on stderr and ownership stays
# inside the fixture tree.
mount_entry "$tmp/resolve" ext4 > "$tmp/mountinfo"
: > "$OWNERSHIP_CALLS"
configure_permissions "$tmp/mountinfo" "$tmp/resolve/two/x/z" > "$tmp/output" 2> "$tmp/cycerr"
grep -q 'Symlink cycle detected' "$tmp/cycerr" || fail "configure_permissions lost the cycle diagnostic"
grep -Fxq -- "-R -- 1000:1000 $tmp/resolve/two/x/z" "$OWNERSHIP_CALLS" \
    || fail "cycle target must chown the original spelling"
if grep -Fq "$tmp/resolve/two/y" "$OWNERSHIP_CALLS"; then
    fail "ownership command targeted an in-cycle spelling other than the original"
fi

mount_entry "$tmp/local" ext4 > "$tmp/mountinfo"
mount_entry "$tmp/local/network" cifs >> "$tmp/mountinfo"
mount_entry "$tmp/local/branch/nested" nfs4 >> "$tmp/mountinfo"
: > "$OWNERSHIP_CALLS"
: > "$tmp/deadlines"
configure_permissions "$tmp/mountinfo" "$tmp/local" > "$tmp/output"
grep -Fxq -- "-h -- 1000:1000 $tmp/local" "$OWNERSHIP_CALLS" || fail "local target ownership was skipped"
grep -Fxq -- "-h -- 1000:1000 $tmp/local/branch" "$OWNERSHIP_CALLS" || fail "local ancestor of deeper mount was skipped"
grep -Fxq -- "-h -R -- 1000:1000 $tmp/local/.hidden $tmp/local/config.yaml $tmp/local/link $tmp/local/with spaces" "$OWNERSHIP_CALLS" || fail "mount-free target siblings were not batched into one chown"
grep -Fxq -- "-h -R -- 1000:1000 $tmp/local/branch/local.txt" "$OWNERSHIP_CALLS" || fail "mount-free branch sibling was not chowned"
[[ "$(wc -l < "$OWNERSHIP_CALLS")" -eq 4 ]] || fail "selective pass issued unexpected ownership commands"
if grep -Fq "$tmp/local/network" "$OWNERSHIP_CALLS" || grep -Fq "$tmp/local/branch/nested" "$OWNERSHIP_CALLS"; then
    fail "ownership worker touched a network subtree"
fi
[[ "$(wc -l < "$tmp/deadlines")" -eq 1 ]] || fail "selective pass must use one deadline for the whole target"
grep -q '^--kill-after=2s 10s bash ' "$tmp/deadlines" || fail "selective pass was not bounded"

# A mount covering the target must still be skipped completely.
mount_entry "$tmp/local" cifs > "$tmp/mountinfo"
: > "$OWNERSHIP_CALLS"
: > "$tmp/deadlines"
configure_permissions "$tmp/mountinfo" "$tmp/local" > "$tmp/output"
[[ ! -s "$OWNERSHIP_CALLS" ]] || fail "covered target must stay untouched"
[[ "$(wc -l < "$tmp/deadlines")" -eq 1 ]] || fail "network detection must share the ownership deadline"

# Ownership errors in a selective pass are logged without failing container init.
mount_entry "$tmp/local/network" cifs > "$tmp/mountinfo"
export CHOWN_RESULT=1
: > "$OWNERSHIP_CALLS"
configure_permissions "$tmp/mountinfo" "$tmp/local" > "$tmp/output" || fail "selective failure aborted startup"
grep -q 'failed or timed out' "$tmp/output" || fail "selective failure was not logged"
grep -Fq "$tmp/local/config.yaml" "$OWNERSHIP_CALLS" || fail "one ownership failure skipped other local files"

# A target spelled as a symlink alias, with a trailing slash, or through a
# relative symlink must normalise to the canonical spelling before
# detection, so every spelling follows the same selective pass the canonical
# target gets.
unset CHOWN_RESULT
mount_entry "$tmp/local" ext4 > "$tmp/mountinfo"
mount_entry "$tmp/local/network" cifs >> "$tmp/mountinfo"
mount_entry "$tmp/local/branch/nested" nfs4 >> "$tmp/mountinfo"
ln -s local "$tmp/alias"
ln -s ./local "$tmp/twin"
: > "$OWNERSHIP_CALLS"
: > "$tmp/deadlines"
configure_permissions "$tmp/mountinfo" "$tmp/alias" "$tmp/twin" "$tmp/local/" > "$tmp/output"
grep -Fxq -- "-h -- 1000:1000 $tmp/local" "$OWNERSHIP_CALLS" || fail "symlinked target was not normalised to its canonical spelling"
grep -Fxq -- "-h -R -- 1000:1000 $tmp/local/.hidden $tmp/local/config.yaml $tmp/local/link $tmp/local/with spaces" "$OWNERSHIP_CALLS" || fail "normalised target siblings were not batched"
[[ "$(wc -l < "$OWNERSHIP_CALLS")" -eq 12 ]] || fail "normalised targets must follow the same selective pass"
if grep -Fq "$tmp/local/network" "$OWNERSHIP_CALLS" || grep -Fq "$tmp/local/branch/nested" "$OWNERSHIP_CALLS"; then
    fail "normalised target pass touched a network subtree"
fi
[[ "$(wc -l < "$tmp/deadlines")" -eq 3 ]] || fail "each normalised target must get its own bounded selective pass"

# Aliases of a covering network mount must also be skipped after resolution.
mount_entry "$tmp/local" cifs > "$tmp/mountinfo"
: > "$OWNERSHIP_CALLS"
configure_permissions "$tmp/mountinfo" "$tmp/alias" "$tmp/twin" "$tmp/local/" > "$tmp/output"
[[ ! -s "$OWNERSHIP_CALLS" ]] || fail "alias of a covering network mount was chowned"
[[ "$(grep -c 'Skipping ownership changes for network mount' "$tmp/output")" -eq 3 ]] || fail "network aliases were not skipped"

# A stalled metadata operation during canonicalisation must share the ownership
# deadline. Delay readlink on a real symlink, ignore TERM to exercise the forced
# stop, and check that initialization still handles the following local target.
mkdir -p "$tmp/after-stall"
ln -s local "$tmp/stalled-alias"
REAL_READLINK="$(command -v readlink)"
export REAL_READLINK
export BLOCKED_SYMLINK="$tmp/stalled-alias"
export METADATA_BLOCK_MARKER="$tmp/metadata-blocked"
cat > "$tmp/bin/readlink" <<'STUB'
#!/usr/bin/env bash
if [[ "$1" == "$BLOCKED_SYMLINK" ]]; then
    echo blocked > "$METADATA_BLOCK_MARKER"
    trap '' TERM
    sleep 30
    exit 1
fi
exec "$REAL_READLINK" "$@"
STUB
chmod +x "$tmp/bin/readlink"
: > "$OWNERSHIP_CALLS"
# Shorten the production deadlines only in this test, retaining a separate
# watchdog so the old, unbounded canonicalisation fails promptly as well.
cat > "$tmp/stalled-check" <<'CHECK'
source "$1"
timeout() {
    [[ "$1" == --kill-after=2s && "$2" == 10s ]] || exit 1
    shift 2
    command timeout --kill-after=0.2s 1s "$@"
}
configure_permissions "$2" "$3" "$4"
CHECK
if ! command timeout --kill-after=1s 4s bash "$tmp/stalled-check" "$root/docker/root/etc/cont-init.d/30-config" "$tmp/mountinfo" "$tmp/stalled-alias" "$tmp/after-stall" > "$tmp/stalled-output" 2>&1; then
    cat "$tmp/stalled-output" >&2
    fail "stalled path resolution prevented initialization from continuing"
fi
[[ -s "$METADATA_BLOCK_MARKER" ]] || fail "stalled metadata fixture was not reached"
grep -q 'failed or timed out' "$tmp/stalled-output" || fail "stalled path resolution was not logged"
grep -Fxq -- "-R -- 1000:1000 $tmp/after-stall" "$OWNERSHIP_CALLS" || fail "stalled path resolution skipped the next local target"
if grep -Fq "$tmp/stalled-alias" "$OWNERSHIP_CALLS"; then
    fail "stalled target reached chown"
fi

echo "Container permission regressions passed"
