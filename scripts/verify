#!/usr/bin/env bash
#
# scripts/verify — deterministic local verification gate for Premiumizearr-Nova.
#
# Single mandatory entry point; CI mirrors it in .github/workflows/verify.yml.
# Contract: PROJECT.md / ARCHITECTURE.md ("scripts/verify (the gate)").
#
# Rules enforced here:
#   - never skip a mandatory check;
#   - never download/install toolchains (GOTOOLCHAIN=local; npm dependencies
#     are the only downloads);
#   - never modify go.mod or product source to satisfy a check;
#   - fail with an actionable message on the first failing check.

set -euo pipefail

# --- Anchor to repository root (this script lives in <root>/scripts). -------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${ROOT_DIR}"

fail() {
  echo ""
  echo "VERIFY: FAILED — $*"
  echo "        Fix the failing check, then re-run: bash scripts/verify"
  exit 1
}

step() {
  echo ""
  echo "=== verify: $*"
}

# --- Preflight: required tools and versions ---------------------------------

step "Preflight: required tools"

# Go: verification always runs on the locally provisioned toolchain and never
# downloads one: GOTOOLCHAIN=local is exported before any go invocation.
# go.mod is intentionally left as-is:
#   go 1.23.0        (minimum project floor)
#   toolchain go1.24.2 (project toolchain; dev/CI provision it explicitly)
# so the gate requires the local go to be >= 1.24.2. We never edit go.mod to
# make this pass.
if ! command -v go >/dev/null 2>&1; then
  fail "go command not found. Install Go >= 1.24.2 (verification uses the locally provisioned toolchain via GOTOOLCHAIN=local)."
fi

export GOTOOLCHAIN=local
echo "go command on PATH:      $(go version)"
echo "GOTOOLCHAIN:             local (pinned by this script)"

LOCAL_GO="$(go env GOVERSION 2>/dev/null)" || fail \
  "go could not report its version (go env GOVERSION failed)."
if ! printf '%s\n%s\n' "1.24.2" "${LOCAL_GO#go}" | sort -V -C; then
  fail "local Go ${LOCAL_GO} is older than 1.24.2. Verification uses the locally provisioned toolchain (GOTOOLCHAIN=local) and never downloads one; install Go >= 1.24.2 (go.mod 'go 1.23.0' / 'toolchain go1.24.2' stays as-is)."
fi

# Node: project standard is Node 26 (ARCHITECTURE.md, approved decision 1).
if ! command -v node >/dev/null 2>&1; then
  fail "node not found. The project standard is Node 26 (e.g. install via nvm: 'nvm install 26 && nvm use 26')."
fi
NODE_VERSION="$(node -p 'process.versions.node')"
NODE_MAJOR="${NODE_VERSION%%.*}"
echo "node:                    ${NODE_VERSION}"
if [[ "${NODE_MAJOR}" != "26" ]]; then
  fail "Node ${NODE_VERSION} found; the project standard is Node 26. Install/activate Node 26 (e.g. 'nvm install 26 && nvm use 26')."
fi

if ! command -v npm >/dev/null 2>&1; then
  fail "npm not found. Install it together with Node 26."
fi
echo "npm:                     $(npm --version)"

# C compiler: required by 'go test -race' (the race detector links via cgo).
CC_BIN="$(command -v cc 2>/dev/null || command -v gcc 2>/dev/null || command -v clang 2>/dev/null || true)"
if [[ -z "${CC_BIN}" ]]; then
  fail "no C compiler found (cc/gcc/clang). 'go test -race' requires a C toolchain (e.g. 'apt-get install gcc')."
fi
echo "C compiler:              ${CC_BIN}"

# curl: required by the web dev-server smoke check (serves bundle.js over HTTP).
if ! command -v curl >/dev/null 2>&1; then
  fail "curl not found. The web dev-server smoke check fetches bundle.js over HTTP (e.g. 'apt-get install curl')."
fi
echo "curl:                    $(curl --version | head -1)"

# --- Mandatory checks (the gate fails on the first failure) ------------------

step "Check 1/12: gofmt clean, incl. -s simplifications (tracked Go files)"
UNFORMATTED="$(git ls-files -z '*.go' | xargs -0 -r gofmt -s -l)"
if [[ -n "${UNFORMATTED}" ]]; then
  printf '%s\n' "${UNFORMATTED}" | sed 's/^/    /'
  fail "tracked Go files are not gofmt/simplify-clean. Run 'gofmt -s -w' on them."
fi
echo "all tracked Go files gofmt -s clean"

step "Check 2/12: go vet"
if ! go vet ./...; then
  fail "go vet ./... reported findings. Fix them per their intended behavior; no suppressions or -vet=off (see PROJECT.md)."
fi

step "Check 3/12: go mod verify (module checksums against go.sum)"
if ! go mod verify; then
  fail "go mod verify failed: module checksums do not match go.sum (possible module-cache tampering)."
fi

step "Check 4/12: go mod tidy drift (go.mod/go.sum vs. real imports)"
if ! go mod tidy -diff; then
  fail "go mod tidy -diff reported changes: go.mod/go.sum are out of sync with the real imports. Run 'go mod tidy' and commit the result."
fi

step "Check 5/12: production-style Go build"
BUILD_DIR="$(mktemp -d)"
trap 'rm -rf "${BUILD_DIR}"' EXIT
if ! CGO_ENABLED=0 go build -tags 'netgo osusergo' -ldflags '-extldflags "-static"' -o "${BUILD_DIR}/premiumizearrd" ./cmd/premiumizearrd; then
  fail "production-style build failed (CGO_ENABLED=0, tags 'netgo osusergo', static)."
fi
echo "built ${BUILD_DIR}/premiumizearrd"

step "Check 6/12: release cross-compile check (linux/arm64)"
if ! CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -tags 'netgo osusergo' -ldflags '-extldflags "-static"' -o "${BUILD_DIR}/premiumizearrd-linux-arm64" ./cmd/premiumizearrd; then
  fail "linux/arm64 cross-compile failed (a release target built by goreleaser; caught here before the release)."
fi
echo "built ${BUILD_DIR}/premiumizearrd-linux-arm64"

step "Check 7/12: go test -race"
if ! go test -race ./...; then
  fail "go test -race ./... failed."
fi

step "Check 8/12: config file validation (CI workflows, goreleaser, config.yaml, renovate.json)"
if ! go run ./scripts/configlint .github/workflows/*.yml .goreleaser.yaml .prerelease.goreleaser.yaml config.yaml renovate.json; then
  fail "config file validation failed: at least one YAML/JSON config file has a syntax error."
fi

step "Check 9/12: web dependencies (npm ci, locked graph)"
if ! (cd web && npm ci); then
  fail "npm ci failed in web/ (package-lock.json must be in sync with package.json)."
fi

step "Check 10/12: npm audit (full dependency tree, high and above)"
if ! (cd web && npm audit --audit-level=high); then
  fail "npm audit reported high/critical vulnerabilities. Resolve them (update via Renovate/OSV or replace the dependency)."
fi

step "Check 11/12: web production build"
if ! (cd web && npm run build); then
  fail "web production build failed (npm run build)."
fi

step "Check 12/12: web dev-server smoke (npm run dev serves bundle.js)"
DEV_LOG="$(mktemp)"
DEV_PID=""
cleanup() {
  # Also fires on interruption: never leave the dev server running on port
  # 8080, where a later smoke run would pass against a stale server.
  if [[ -n "${DEV_PID}" ]]; then
    kill -TERM -- "-${DEV_PID}" 2>/dev/null || true
    kill -TERM "${DEV_PID}" 2>/dev/null || true
  fi
  rm -rf "${BUILD_DIR}" "${DEV_LOG}"
}
trap cleanup EXIT
setsid bash -c 'cd web && npm run dev' >"${DEV_LOG}" 2>&1 &
DEV_PID=$!
BUNDLE_OK=0
for _ in $(seq 1 30); do
  if curl -fsS --max-time 3 -o /dev/null http://127.0.0.1:8080/bundle.js; then
    BUNDLE_OK=1
    break
  fi
  sleep 1
done
kill -TERM -- "-${DEV_PID}" 2>/dev/null || true
kill -TERM "${DEV_PID}" 2>/dev/null || true
wait "${DEV_PID}" 2>/dev/null || true
DEV_PID=""
if [[ "${BUNDLE_OK}" -ne 1 ]]; then
  tail -20 "${DEV_LOG}"
  fail "web dev-server smoke failed: http://127.0.0.1:8080/bundle.js not reachable within 30s of 'npm run dev'."
fi
echo "dev server served bundle.js over HTTP"

echo ""
echo "VERIFY: PASS — all checks green"
